# Gerado pelo HyPHP — não editar à mão.
# Fonte: internal/webserver/apache/templates/vhost.conf.tmpl
# Projeto: {{.Site.ID}} ({{.Site.Domain}}) → pool {{.Site.PoolName}}

<VirtualHost *:{{.Ports.HTTP}}>
    ServerName {{.Site.Domain}}
{{- range .Site.Aliases}}
    ServerAlias {{.}}
{{- end}}
    DocumentRoot "{{.Site.Docroot}}"
    DirectoryIndex index.php index.html

    <Directory "{{.Site.Docroot}}">
        Require all granted
        Options -Indexes +FollowSymLinks
        AllowOverride All
    </Directory>

    # A barra final evita "400 Proxy Error: URI cannot be parsed" no Windows,
    # onde sem ela o Apache cola a letra do drive na porta (spec §6.2).
    #
    # ProxyFCGISetEnvIf é obrigatório: o SCRIPT_FILENAME que o mod_proxy_fcgi
    # deriva sozinho mudou entre builds — o Apache 2.4.68 entrega ao php-cgi um
    # caminho que não existe, e TODO projeto responde "No input file
    # specified.", inclusive uma pasta com um único index.php. Montar o valor a
    # partir de DOCUMENT_ROOT + SCRIPT_NAME não depende da build.
    <FilesMatch "\.php$">
        SetHandler "proxy:balancer://{{.Site.PoolName}}/"
        ProxyFCGISetEnvIf "true" SCRIPT_FILENAME "%{reqenv:DOCUMENT_ROOT}%{reqenv:SCRIPT_NAME}"
    </FilesMatch>

    ErrorLog "{{.LogDir}}/{{.Site.ID}}-error.log"
    CustomLog "{{.LogDir}}/{{.Site.ID}}-access.log" combined
</VirtualHost>
{{if .Site.TLSCert}}
<VirtualHost *:{{.Ports.HTTPS}}>
    ServerName {{.Site.Domain}}
{{- range .Site.Aliases}}
    ServerAlias {{.}}
{{- end}}
    DocumentRoot "{{.Site.Docroot}}"
    DirectoryIndex index.php index.html

    <Directory "{{.Site.Docroot}}">
        Require all granted
        Options -Indexes +FollowSymLinks
        AllowOverride All
    </Directory>

    <FilesMatch "\.php$">
        SetHandler "proxy:balancer://{{.Site.PoolName}}/"
        ProxyFCGISetEnvIf "true" SCRIPT_FILENAME "%{reqenv:DOCUMENT_ROOT}%{reqenv:SCRIPT_NAME}"
    </FilesMatch>

    SSLEngine on
    SSLCertificateFile "{{.Site.TLSCert}}"
    SSLCertificateKeyFile "{{.Site.TLSKey}}"

    ErrorLog "{{.LogDir}}/{{.Site.ID}}-error.log"
    CustomLog "{{.LogDir}}/{{.Site.ID}}-access.log" combined
</VirtualHost>
{{end}}