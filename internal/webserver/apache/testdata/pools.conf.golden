# Gerado pelo HyPHP — não editar à mão.
# Fonte: internal/webserver/apache/templates/pools.conf.tmpl
#
# Um balancer por série de PHP ativa, um BalancerMember por worker php-cgi.
# lbmethod=bybusyness e nunca o método por contagem de requisições: php-cgi no
# Windows atende UM request por vez (spec §6.3), então o roteamento tem de
# olhar ocupação, não contagem.

<Proxy "balancer://php72">
    BalancerMember "fcgi://127.0.0.1:9002"
    BalancerMember "fcgi://127.0.0.1:9003"
    ProxySet lbmethod=bybusyness
</Proxy>

<Proxy "balancer://php81">
    BalancerMember "fcgi://127.0.0.1:9000"
    BalancerMember "fcgi://127.0.0.1:9001"
    ProxySet lbmethod=bybusyness
</Proxy>
