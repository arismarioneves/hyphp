# Gerado pelo HyPHP — não editar à mão.
# Fonte: internal/webserver/nginx/templates/upstreams.conf.tmpl
#
# least_conn cumpre no nginx o papel do lbmethod=bybusyness do Apache: cada
# worker php-cgi atende UM request por vez (spec §6.3), então o critério tem
# de ser conexões abertas, não round-robin.

upstream php72 {
    least_conn;
    server 127.0.0.1:9002;
    server 127.0.0.1:9003;
}

upstream php81 {
    least_conn;
    server 127.0.0.1:9000;
    server 127.0.0.1:9001;
}
