# Gerado pelo HyPHP — não editar à mão.
# Fonte: internal/webserver/nginx/templates/nginx.conf.tmpl
#
# RELOCÁVEL: os includes são relativos e o nginx os resolve contra o prefixo
# passado em -p. Por isso este mesmo arquivo serve para etc/nginx.next (onde é
# validado) e para etc/nginx (onde é executado), sem reescrita.

worker_processes 2;
pid "/Users/joao/Library/Application Support/HyPHP/log/nginx.pid";
error_log "/Users/joao/Library/Application Support/HyPHP/log/nginx-error.log";
worker_rlimit_nofile 4096;

events {
    worker_connections 1024;
}

http {
    include "/opt/homebrew/etc/nginx/mime.types";
    default_type application/octet-stream;
    sendfile on;
    client_max_body_size 64m;
    access_log "/Users/joao/Library/Application Support/HyPHP/log/nginx-access.log";

    # Relativos a -p: os padrões compilados do Homebrew ficam em var/run/nginx,
    # compartilhados com o nginx do brew services.
    client_body_temp_path temp/client_body;
    fastcgi_temp_path temp/fastcgi;
    proxy_temp_path temp/proxy;
    scgi_temp_path temp/scgi;
    uwsgi_temp_path temp/uwsgi;

    # Calculado a partir do nome mais longo (nginx.go, namesBucketSize): com o
    # padrão de 32 do Windows, um domínio comprido derruba o nginx -t.
    server_names_hash_bucket_size 64;

    # Zona compartilhada declarada UMA vez: repetir o mesmo nome em cada site
    # faria o nginx abortar com "shared memory zone already declared".
    ssl_session_cache shared:hyphp_ssl:10m;
    ssl_session_timeout 10m;

    include upstreams.conf;
    include sites/*.conf;

    # Host default: responde por qualquer domínio que não casa com projeto.
    # root relativo é resolvido contra -p, ou seja <etcDir>/html.
    server {
        listen 8080 default_server;
        server_name _;
        root html;
        index index.html;
    }
}
