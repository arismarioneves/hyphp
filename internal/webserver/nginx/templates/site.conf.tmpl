# Gerado pelo HyPHP — não editar à mão.
# Fonte: internal/webserver/nginx/templates/site.conf.tmpl
# Projeto: {{.Site.ID}} ({{.Site.Domain}}) → upstream {{.Site.PoolName}}

server {
    listen {{.Ports.HTTP}};
    server_name {{.Site.Domain}}{{range .Site.Aliases}} {{.}}{{end}};
    root "{{.Site.Docroot}}";
    index index.php index.html;

    access_log "{{.LogDir}}/{{.Site.ID}}-access.log";
    error_log "{{.LogDir}}/{{.Site.ID}}-error.log";

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # O split + try_files recusa "/uploads/foto.jpg/x.php": com cgi.fix_pathinfo=1
    # o php-cgi recuaria para foto.jpg e o executaria. A regex aceita "/x.php/rota"
    # para manter PATH_INFO (slash arguments); o set guarda o valor porque o
    # try_files zera $fastcgi_path_info.
    location ~ [^/]\.php(/|$) {
        fastcgi_split_path_info ^(.+?\.php)(/.*)$;
        try_files $fastcgi_script_name =404;
        set $path_info $fastcgi_path_info;
        fastcgi_pass {{.Site.PoolName}};
        fastcgi_index index.php;
        include "{{.ServerRoot}}/conf/fastcgi_params";
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $path_info;
        fastcgi_read_timeout 300;
    }
}
{{if .Site.TLSCert}}
server {
    listen {{.Ports.HTTPS}} ssl;
    server_name {{.Site.Domain}}{{range .Site.Aliases}} {{.}}{{end}};
    root "{{.Site.Docroot}}";
    index index.php index.html;

    ssl_certificate "{{.Site.TLSCert}}";
    ssl_certificate_key "{{.Site.TLSKey}}";
    ssl_protocols TLSv1.2 TLSv1.3;

    access_log "{{.LogDir}}/{{.Site.ID}}-access.log";
    error_log "{{.LogDir}}/{{.Site.ID}}-error.log";

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # O split + try_files recusa "/uploads/foto.jpg/x.php": com cgi.fix_pathinfo=1
    # o php-cgi recuaria para foto.jpg e o executaria. A regex aceita "/x.php/rota"
    # para manter PATH_INFO (slash arguments); o set guarda o valor porque o
    # try_files zera $fastcgi_path_info.
    location ~ [^/]\.php(/|$) {
        fastcgi_split_path_info ^(.+?\.php)(/.*)$;
        try_files $fastcgi_script_name =404;
        set $path_info $fastcgi_path_info;
        fastcgi_pass {{.Site.PoolName}};
        fastcgi_index index.php;
        include "{{.ServerRoot}}/conf/fastcgi_params";
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $path_info;
        fastcgi_param HTTPS on;
        fastcgi_read_timeout 300;
    }
}
{{end}}